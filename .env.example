# Copy this file to .env (or export these directly) before running the prototype.
# Never commit a real .env file.

# API key the /api/v1/invoices and /api/v1/documents endpoints require via the X-Api-Key header.
TRAINING_API_KEY=replace-with-a-local-training-key

# Optional. Defaults to 8080 if not set.
PORT=8080
